APPNAME=
JWTSECRET=
APPENV=
APPPORT=
GINMODE=
SHUTDOWNTIMEOUT=
DBHOST=
DBPORT=
DBNAME=
DBUSER=
DBPASS=
DBTIMEOUT=30s
DBREADTIMEOUT=5m
DBWRITETIMEOUT=5m

# MySQL Connection Pooling
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3m
DB_CONN_MAX_IDLE_TIME=30s

CORSALLOWORIGIN=
CORSALLOWMETHODS=
CORSALLOWHEADERS=
CORSMAXAGE=
CORSALLOWCREDENTIALS=
CORSCONTENTTYPE=

# Redis configuration (optional). Use REDIS_ADDR as host:port.
# If you prefer separate host/port variables, set REDIS_ADDR accordingly.
REDIS_ADDR=
REDIS_PASS=
REDIS_DB=0

GEOIP_DB_PATH=

# TLS/HTTPS Configuration
ENABLE_TLS=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# HSTS (HTTP Strict Transport Security) Configuration
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true